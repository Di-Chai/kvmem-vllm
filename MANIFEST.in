recursive-include csrc *.cpp *.cu *.cuh *.hpp *.json
recursive-include src/vllm_kvmem native*.cuh native_attention_sources.json
recursive-include src/vllm_kvmem/apps/webui/static *
recursive-include src/vllm_kvmem/apps/webui/profiles *.json
graft ui
prune ui/node_modules
prune ui/test-results
prune ui/chat/node_modules
prune ui/chat/.svelte-kit
prune ui/chat/dist
recursive-include third_party/qw3 *.hpp *.cpp LICENSE *.json
recursive-include third_party/vllm *.py LICENSE *.json
include CMakeLists.txt requirements-cu130.lock
recursive-include docs *.md *.svg *.json
include CONTRIBUTING.md
recursive-include examples *.json
recursive-include scripts *.py *.sh
recursive-include benchmarks/deepswe *.py *.json LICENSE *.md
